{
  "id": "/",
  "name": "Dawn",
  "short_name": "Dawn",
  "description": "Morning habit tracker — wake, sleep, gym, reading, Quran",
  "start_url": "/dashboard?ritual=1",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#071018",
