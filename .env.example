NEXTAUTH_URL=http://127.0.0.1:3066
NEXTAUTH_SECRET=generate-a-long-random-string

# Discord OAuth (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord Bot
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Optional: shared secret so the bot/cron can hit /api/reminders/tick
REMINDER_TICK_SECRET=

# Postgres for Vercel/Railway (Neon: https://neon.tech)
# Local sqlite example: DATABASE_URL="file:./dev.db"
# Production example: DATABASE_URL="postgresql://user:pass@host/neondb?sslmode=require"
DATABASE_URL="file:./dev.db"

# AI coach (OpenAI-compatible: OpenAI / Groq / OpenRouter / Ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (preferred when set)
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional force: gemini | openai
AI_PROVIDER=gemini
