NEXTAUTH_URL=http://127.0.0.1:3066
NEXTAUTH_SECRET=generate-a-long-random-string

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Create OAuth client → Web application
# Redirect: http://127.0.0.1:3066/api/auth/callback/google
# Production: https://YOUR-DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord Bot
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# Optional: comma-separated study voice channel IDs (or use /study-room add)
DISCORD_STUDY_VOICE_IDS=

# Optional: shared secret so the bot/cron can hit /api/reminders/tick
REMINDER_TICK_SECRET=

# Web Push (optional). If unset, Dawn generates VAPID keys into the database.
# npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Postgres for Vercel/Railway (Neon: https://neon.tech)
# Local sqlite example: DATABASE_URL="file:./dev.db"
# Production example: DATABASE_URL="postgresql://user:pass@host/neondb?sslmode=require"
DATABASE_URL="file:./dev.db"

# AI coach (OpenAI-compatible: OpenAI / Groq / OpenRouter / Ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (preferred when set)
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional force: gemini | openai
AI_PROVIDER=gemini
